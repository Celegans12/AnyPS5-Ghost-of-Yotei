cmake_minimum_required(VERSION 3.20)

file(STRINGS "${LIST_FILE}" sources ENCODING UTF-8)
list(SORT sources)
set(manifest "kyty-shader-store 1\n")
foreach(source IN LISTS sources)
    if(NOT EXISTS "${source}")
        continue()
    endif()
    file(READ "${source}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(SHA256 digest "${text}")
    file(RELATIVE_PATH relative "${ROOT}" "${source}")
    string(APPEND manifest "${relative} ${digest}\n")
endforeach()
string(SHA256 stamp "${manifest}")
string(SUBSTRING "${stamp}" 0 16 stamp)
set(content "#ifndef KYTY_SHADER_STORE_STAMP\n#define KYTY_SHADER_STORE_STAMP 0x${stamp}ULL\n#endif\n")
set(previous "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
