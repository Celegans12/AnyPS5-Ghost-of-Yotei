cmake_minimum_required(VERSION 3.20)

file(STRINGS "${LIST_FILE}" sources ENCODING UTF-8)
list(SORT sources)
set(manifest "kyty-shader-store 1\n")
foreach(source IN LISTS sources)
    if(NOT EXISTS "${source}")
        continue()
    endif()
    file(READ "${source}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(SHA256 digest "${text}")
    file(RELATIVE_PATH relative "${ROOT}" "${source}")
    string(APPEND manifest "${relative} ${digest}\n")
endforeach()
if(DEFINED PACKED_KEY_FILE)
    file(READ "${PACKED_KEY_FILE}" header)
    string(REPLACE "\r\n" "\n" header "${header}")
    string(REGEX MATCHALL "#[ \t]*pragma[ \t]+pack[^\n]*" packing "${header}")
    list(LENGTH packing count)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "Expected one packed graphics key block in ${PACKED_KEY_FILE}")
    endif()
    list(GET packing 0 push)
    list(GET packing 1 pop)
    string(FIND "${header}" "${push}" begin)
    string(FIND "${header}" "${pop}" end)
    string(LENGTH "${pop}" pop_size)
    math(EXPR length "${end} - ${begin} + ${pop_size}")
    string(SUBSTRING "${header}" ${begin} ${length} packed_key)
    if(NOT push MATCHES "push" OR NOT pop MATCHES "pop" OR packed_key MATCHES "#[ \t]*include")
        message(FATAL_ERROR "Expected the complete graphics key layout between pack directives in ${PACKED_KEY_FILE}")
    endif()
    foreach(type IN ITEMS PipelineStaticParameters PipelineRenderingState PipelineVertexInputState GraphicsPipelineKey)
        if(NOT packed_key MATCHES "struct[ \t]+(alignas\\([^)]*\\)[ \t]+)?${type}[ \t\n]*\\{")
            message(FATAL_ERROR "Missing packed ${type} in ${PACKED_KEY_FILE}")
        endif()
    endforeach()
    string(SHA256 digest "${packed_key}")
    file(RELATIVE_PATH relative "${ROOT}" "${PACKED_KEY_FILE}")
    string(APPEND manifest "${relative}:GraphicsPipelineKey ${digest}\n")
endif()
string(SHA256 stamp "${manifest}")
string(SUBSTRING "${stamp}" 0 16 stamp)
if(NOT DEFINED NAME)
    set(NAME KYTY_SHADER_STORE_STAMP)
endif()
set(content "#ifndef ${NAME}\n#define ${NAME} 0x${stamp}ULL\n#endif\n")
set(previous "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
