function(kyty_pgo_find_profdata out_var)
    string(REGEX MATCH "^[0-9]+" clang_major "${CMAKE_CXX_COMPILER_VERSION}")
    get_filename_component(compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
    find_program(KYTY_LLVM_PROFDATA NAMES "llvm-profdata-${clang_major}" llvm-profdata
        HINTS "${compiler_dir}" "/usr/lib/llvm-${clang_major}/bin")
    if(NOT KYTY_LLVM_PROFDATA)
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    execute_process(COMMAND "${KYTY_LLVM_PROFDATA}" --version OUTPUT_VARIABLE version ERROR_VARIABLE version RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT version MATCHES "LLVM version ([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL clang_major)
        message(WARNING "KYTY_PGO_PROFILE: ${KYTY_LLVM_PROFDATA} is not the llvm-profdata of LLVM ${clang_major} (the compiler's major): install llvm-${clang_major}, or set KYTY_LLVM_PROFDATA")
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    set(${out_var} "${KYTY_LLVM_PROFDATA}" PARENT_SCOPE)
endfunction()

function(kyty_pgo_source_list out_var)
    file(REAL_PATH "${ANYPS5_SOURCE_DIR}" root)
    file(GLOB_RECURSE sources LIST_DIRECTORIES false RELATIVE "${root}"
        "${KYTY_DIR}/graphics/*.cpp" "${KYTY_DIR}/graphics/*.h" "${KYTY_DIR}/graphics/*.inc"
        "${KYTY_DIR}/common/*.cpp" "${KYTY_DIR}/common/*.h" "${KYTY_DIR}/common/*.inc")
    list(APPEND sources
        core/libs/prx/libSceAgcDriver/KytyShim/src/MemoryBacking.cpp
        core/libs/prx/libSceAgcDriver/KytyShim/src/MemoryGpu.cpp)
    list(SORT sources)
    set(${out_var} ${sources} PARENT_SCOPE)
endfunction()

function(kyty_pgo_check_sources profile)
    file(STRINGS "${profile}" header REGEX "^# kyty-pgo-")
    set(trained "")
    set(known "")
    foreach(line IN LISTS header)
        if(line MATCHES "^# kyty-pgo-trained (.*)$")
            set(trained "${CMAKE_MATCH_1}")
        elseif(line MATCHES "^# kyty-pgo-source ([0-9a-f]+) (.+)$")
            set("kytyPgoHash_${CMAKE_MATCH_2}" "${CMAKE_MATCH_1}")
            list(APPEND known "${CMAKE_MATCH_2}")
        endif()
    endforeach()
    if(known STREQUAL "")
        message(STATUS "kyty_gpu PGO: ${profile} carries no source fingerprints, staleness not checked")
        return()
    endif()
    kyty_pgo_source_list(sources)
    file(REAL_PATH "${ANYPS5_SOURCE_DIR}" root)
    set(changed "")
    set(added 0)
    foreach(source IN LISTS sources)
        if(NOT DEFINED "kytyPgoHash_${source}")
            math(EXPR added "${added} + 1")
            continue()
        endif()
        file(READ "${root}/${source}" content)
        string(REPLACE "\r" "" content "${content}")
        string(SHA1 hash "${content}")
        if(NOT hash STREQUAL "${kytyPgoHash_${source}}")
            list(APPEND changed "${source}")
        endif()
    endforeach()
    list(LENGTH sources total)
    list(LENGTH changed changed_count)
    if(changed_count EQUAL 0 AND added EQUAL 0)
        message(STATUS "kyty_gpu PGO: ${profile} matches the ${total} sources it was trained on (${trained})")
        return()
    endif()
    list(SUBLIST changed 0 8 shown)
    string(REPLACE ";" ", " shown "${shown}")
    message(WARNING "kyty_gpu PGO: the profile is out of date: ${changed_count} of ${total} Kyty sources changed and ${added} are new "
        "since it was trained (${trained}; changed: ${shown}). The build goes on with it: functions whose control flow changed lose "
        "their counts (clang's -Wbackend-plugin and -Wprofile-instr-out-of-date warnings name them), the others keep them. "
        "Regenerate it as docs/dev/KYTY_PGO.md explains.")
endfunction()

function(kyty_pgo_prepare profile out_var)
    set(${out_var} "" PARENT_SCOPE)
    if(NOT IS_ABSOLUTE "${profile}")
        get_filename_component(profile "${profile}" ABSOLUTE BASE_DIR "${ANYPS5_SOURCE_DIR}")
    endif()
    if(NOT EXISTS "${profile}")
        message(WARNING "kyty_gpu PGO: ${profile} does not exist; building kyty_gpu without PGO")
        return()
    endif()
    set_property(DIRECTORY "${KYTY_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${profile}")
    if(profile MATCHES "\\.profdata$")
        message(STATUS "kyty_gpu PGO: indexed profile ${profile}")
        set(${out_var} "${profile}" PARENT_SCOPE)
        return()
    endif()
    kyty_pgo_find_profdata(profdata)
    if(profdata STREQUAL "")
        message(WARNING "kyty_gpu PGO: no llvm-profdata for LLVM ${CMAKE_CXX_COMPILER_VERSION} to read the text profile ${profile}; building kyty_gpu without PGO (install llvm-<major> or set KYTY_LLVM_PROFDATA)")
        return()
    endif()
    set(indexed "${CMAKE_BINARY_DIR}/pgo/kyty_gpu.profdata")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/pgo")
    execute_process(COMMAND "${profdata}" merge --instr -o "${indexed}.tmp" "${profile}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
    if(NOT result EQUAL 0)
        message(WARNING "kyty_gpu PGO: ${profdata} could not read ${profile} (${output}); building kyty_gpu without PGO")
        return()
    endif()
    file(COPY_FILE "${indexed}.tmp" "${indexed}" ONLY_IF_DIFFERENT)
    file(REMOVE "${indexed}.tmp")
    kyty_pgo_check_sources("${profile}")
    message(STATUS "kyty_gpu PGO: ${profile} -> ${indexed}")
    set(${out_var} "${indexed}" PARENT_SCOPE)
endfunction()
