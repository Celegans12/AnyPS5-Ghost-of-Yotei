cmake_minimum_required(VERSION 3.25)

file(STRINGS "${LIST_FILE}" stamped ENCODING UTF-8)
set(pipeline "${ROOT}/graphics/host_gpu/renderer/pipeline")
file(GLOB_RECURSE candidates "${pipeline}/*.cpp" "${pipeline}/*.h" "${pipeline}/*.inc")
foreach(source IN LISTS candidates)
    if(NOT source IN_LIST stamped)
        file(READ "${source}" code)
        if(code MATCHES "(^|[^A-Za-z0-9_])(KYTY_IO_FIELDS|ShaderStoreFormat|IoStore[A-Za-z0-9_]*|DecodeShaderStoreFrame|SaveResourcePlan|LoadResourcePlan)([^A-Za-z0-9_]|$)"
           OR code MATCHES "m_store[ \t\r\n]*\\.[ \t\r\n]*Append[ \t\r\n]*\\(")
            message(FATAL_ERROR "Shader store serialization in an unstamped pipeline source: ${source}")
        endif()
    endif()
endforeach()

set(schemas "${pipeline}/pipelineStoreFormat.h" "${pipeline}/pipelineStoreTypes.h")
while(schemas)
    list(POP_BACK schemas schema)
    if(schema IN_LIST checked)
        continue()
    endif()
    if(NOT schema IN_LIST stamped)
        message(FATAL_ERROR "Shader store schema missing from the stamp: ${schema}")
    endif()
    list(APPEND checked "${schema}")
    cmake_path(GET schema PARENT_PATH directory)
    file(STRINGS "${schema}" includes REGEX "^[ \t]*#[ \t]*include[ \t]+\"")
    foreach(line IN LISTS includes)
        string(REGEX MATCH "\"([^\"]+)\"" unused "${line}")
        set(header "${CMAKE_MATCH_1}")
        if(EXISTS "${directory}/${header}")
            cmake_path(ABSOLUTE_PATH header BASE_DIRECTORY "${directory}" NORMALIZE OUTPUT_VARIABLE dependency)
        else()
            cmake_path(ABSOLUTE_PATH header BASE_DIRECTORY "${ROOT}" NORMALIZE OUTPUT_VARIABLE dependency)
        endif()
        cmake_path(IS_PREFIX pipeline "${dependency}" NORMALIZE local)
        if(local)
            if(NOT dependency IN_LIST stamped)
                message(FATAL_ERROR "Shader store schema depends on an unstamped pipeline header: ${dependency}")
            endif()
            list(APPEND schemas "${dependency}")
        endif()
    endforeach()
endwhile()
