#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer first_buf {
    uint first[];
};

layout(std430, binding = 1) readonly buffer second_buf {
    uint second[];
};

layout(std430, binding = 2) buffer result_buf {
    uint result[];
};

layout(push_constant) uniform push_data {
    uint count;
    uint slot;
};

shared uint group_differ;
shared uint group_first;

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        group_differ = 0u;
        group_first  = 0xffffffffu;
    }
    barrier();
    uint       differ = 0u;
    uint       found  = 0xffffffffu;
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < count; i += stride) {
        if (first[i] != second[i]) {
            differ++;
            found = min(found, i);
        }
    }
    if (differ != 0u) {
        atomicAdd(group_differ, differ);
        atomicMin(group_first, found);
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u && group_differ != 0u) {
        atomicAdd(result[slot * 8u], group_differ);
        atomicMin(result[slot * 8u + 1u], group_first);
    }
}
