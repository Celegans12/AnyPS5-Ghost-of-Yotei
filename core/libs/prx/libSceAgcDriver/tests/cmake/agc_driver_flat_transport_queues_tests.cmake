if(BUILD_TESTING)
    set(agcFlatTransportEnvironment "ANYPS5_NO_SHADER_CACHE=1;APS5_DRAW_PIPELINE=1;APS5_PIPELINED_DRAWS=32;APS5_PIPELINE_DISPATCH=1;APS5_FLAT_TRANSPORT=1;APS5_VERIFY_PIPELINE_ORDER=1")
    set(agcFlatTransportTests)
    foreach(agcFlatTransportTest IN ITEMS flat_transport_queues finisher_relay_order finisher_label_order finisher_submission_ends draw_pipeline_retired_items draw_recapture_on_change pipelined_dma pipelined_fill pipelined_sample_dump pipelined_metadata_pass pipelined_dispatch draw_cache_reuse)
        add_test(NAME agc_driver_${agcFlatTransportTest}_flat_transport COMMAND agc_driver_${agcFlatTransportTest}_tests)
        set_tests_properties(agc_driver_${agcFlatTransportTest}_flat_transport PROPERTIES ENVIRONMENT "${agcFlatTransportEnvironment}")
        list(APPEND agcFlatTransportTests agc_driver_${agcFlatTransportTest}_flat_transport)
    endforeach()
    foreach(agcFlatTransportTest IN ITEMS flat_transport_queues finisher_pool finisher_relay_order finisher_label_order finisher_submission_ends draw_pipeline_retired_items draw_recapture_on_change draw_cache_reuse)
        add_test(NAME agc_driver_${agcFlatTransportTest}_flat_transport_four_finishers COMMAND agc_driver_${agcFlatTransportTest}_tests)
        set_tests_properties(agc_driver_${agcFlatTransportTest}_flat_transport_four_finishers PROPERTIES ENVIRONMENT "${agcFlatTransportEnvironment};APS5_FINISHER_THREADS=4")
        list(APPEND agcFlatTransportTests agc_driver_${agcFlatTransportTest}_flat_transport_four_finishers)
    endforeach()
    add_test(NAME agc_driver_flat_transport_queues_counted COMMAND agc_driver_flat_transport_queues_tests)
    set_tests_properties(agc_driver_flat_transport_queues_counted PROPERTIES ENVIRONMENT "${agcFlatTransportEnvironment};APS5_PIPELINE_STATS=1")
    add_test(NAME agc_driver_flat_transport_queues_wake_each COMMAND agc_driver_flat_transport_queues_tests)
    set_tests_properties(agc_driver_flat_transport_queues_wake_each PROPERTIES ENVIRONMENT "${agcFlatTransportEnvironment};APS5_TRANSPORT_WAKE_BATCH=1")
    add_test(NAME agc_driver_flat_transport_queues_locked COMMAND agc_driver_flat_transport_queues_tests)
    set_tests_properties(agc_driver_flat_transport_queues_locked PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_DRAW_PIPELINE=1;APS5_PIPELINED_DRAWS=32;APS5_PIPELINE_DISPATCH=1;APS5_VERIFY_PIPELINE_ORDER=1")
    list(APPEND agcFlatTransportTests agc_driver_flat_transport_queues_counted agc_driver_flat_transport_queues_wake_each agc_driver_flat_transport_queues_locked)
    set_tests_properties(${agcFlatTransportTests} PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 120 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
    if(WIN32)
        set_tests_properties(${agcFlatTransportTests} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
