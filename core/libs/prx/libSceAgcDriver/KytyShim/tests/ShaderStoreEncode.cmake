execute_process(COMMAND "${TEST_EXECUTABLE}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result STREQUAL "0" OR NOT stdout MATCHES "kyty_shim_shader_store_encode: ok" OR stderr MATCHES "terminate called")
    message(FATAL_ERROR "Shader-store encoding fixture failed (${result})\n${stdout}\n${stderr}")
endif()

string(REGEX MATCHALL "Shader cache: program 0x[0-9a-f]+ \\([A-Z]+\\) is not written to the store:" warnings "${stderr}")
list(LENGTH warnings warningCount)
if(NOT warningCount EQUAL 2)
    message(FATAL_ERROR "Expected two shader-store refusals, one per program hash\n${stderr}")
endif()
foreach(program IN ITEMS "0x0000000000002222 (CS)" "0x0000000000003333 (PS)")
    string(FIND "${stderr}" "Shader cache: program ${program} is not written to the store: a value of type 0x9008a150 has no cache encoding (opcode IAdd32); the game goes on with the program compiled in memory" warningOffset)
    if(warningOffset EQUAL -1)
        message(FATAL_ERROR "Missing the shader-store refusal for ${program}\n${stderr}")
    endif()
endforeach()
message("${stderr}${stdout}")
