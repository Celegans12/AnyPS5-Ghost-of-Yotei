math(EXPR writerArgument "${CMAKE_ARGC} - 2")
math(EXPR probeArgument "${CMAKE_ARGC} - 1")
set(probe "${CMAKE_ARGV${probeArgument}}")
file(MAKE_DIRECTORY "${DIRECTORY}/blocked.spv")
set(raw "${DIRECTORY}/shader.bin")
set(later "${DIRECTORY}/later.bin")
set(cache "${DIRECTORY}/manifest.spv.guest.spv")
set(plain "${DIRECTORY}/single.spv")
set(pair "${DIRECTORY}/pair.spv")
set(shared "${DIRECTORY}/shared.spv")
set(link "${DIRECTORY}/later-link.spv")
set(early "${DIRECTORY}/early.spv")
set(full "${DIRECTORY}/full.spv")
file(REMOVE "${plain}" "${pair}" "${pair}.guest.spv" "${shared}" "${shared}.guest.spv" "${link}" "${early}" "${full}" "${DIRECTORY}/manifest.spv")
execute_process(COMMAND "${CMAKE_ARGV${writerArgument}}" write-export-fixture "${DIRECTORY}"
        RESULT_VARIABLE result OUTPUT_VARIABLE hash ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result STREQUAL "0" OR NOT hash MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "probe fixture generation failed: ${result}\n${hash}\n${error}")
endif()
configure_file("${raw}" "${later}" COPYONLY)
file(SHA256 "${raw}" rawHash)
file(SHA256 "${cache}" cacheHash)

function(runProbe expectedOutput expectedError)
    execute_process(COMMAND "${probe}" ${ARGN}
            RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result STREQUAL "2" OR NOT stdout MATCHES "${expectedOutput}" OR NOT stderr MATCHES "${expectedError}" OR
            (expectedError STREQUAL "" AND stderr MATCHES "SPIR-V outputs? alias|cannot (open|write|close) SPIR-V output"))
        message(FATAL_ERROR "kyty_rt_probe ${ARGN}: expected exit 2 and matching evidence, got ${result}\n${stdout}\n${stderr}")
    endif()
endfunction()

function(requireSpirv path)
    file(READ "${path}" magic LIMIT 4 HEX)
    file(SIZE "${path}" size)
    if(NOT magic STREQUAL "03022307" OR size LESS_EQUAL 20)
        message(FATAL_ERROR "missing emitted SPIR-V: ${path}")
    endif()
endfunction()

runProbe("spirv=[1-9][0-9]* words" "" --spirv "${plain}" "${raw}")
requireSpirv("${plain}")
runProbe("replay=no" "" --replay-check --spirv "${pair}" --cache "${cache}" --hash "${hash}")
requireSpirv("${pair}")
requireSpirv("${pair}.guest.spv")

runProbe("" "SPIR-V output aliases" --spirv "${raw}" "${raw}")
file(CREATE_LINK "${later}" "${link}")
runProbe("" "SPIR-V output aliases" --spirv "${early}" "${raw}" --spirv "${link}" "${later}")
runProbe("" "SPIR-V output aliases" --replay-check --spirv "${cache}" --cache "${cache}" --hash "${hash}")
runProbe("" "SPIR-V output aliases" --replay-check --spirv "${DIRECTORY}/manifest.spv" --cache "${cache}" --hash "${hash}")
configure_file("${raw}" "${shared}" COPYONLY)
file(CREATE_LINK "${shared}" "${shared}.guest.spv")
runProbe("" "SPIR-V outputs? alias" --replay-check --spirv "${shared}" "${raw}")
if(EXISTS "${early}" OR EXISTS "${DIRECTORY}/manifest.spv")
    message(FATAL_ERROR "preflight failure wrote an earlier output")
endif()
file(SHA256 "${raw}" rawAfter)
file(SHA256 "${later}" laterAfter)
file(SHA256 "${cache}" cacheAfter)
file(SHA256 "${shared}" sharedAfter)
if(NOT rawAfter STREQUAL rawHash OR NOT laterAfter STREQUAL rawHash OR
        NOT cacheAfter STREQUAL cacheHash OR NOT sharedAfter STREQUAL rawHash)
    message(FATAL_ERROR "an alias rejection changed an input or output")
endif()

runProbe("" "cannot open SPIR-V output" --spirv "${DIRECTORY}/blocked.spv" "${raw}")
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    file(CREATE_LINK /dev/full "${full}" SYMBOLIC)
    runProbe("" "cannot (close|write) SPIR-V output" --spirv "${full}" "${raw}")
    file(REMOVE "${full}")
endif()

set(surveyDirectory "${DIRECTORY}/survey")
file(REMOVE_RECURSE "${surveyDirectory}")
file(MAKE_DIRECTORY "${surveyDirectory}")
execute_process(COMMAND "${CMAKE_ARGV${writerArgument}}" write-survey-fixture "${surveyDirectory}"
        RESULT_VARIABLE result OUTPUT_VARIABLE hashes ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result STREQUAL "0" OR NOT hashes MATCHES "^([0-9a-f]+) ([0-9a-f]+) ([0-9a-f]+) ([0-9a-f]+)$")
    message(FATAL_ERROR "survey fixture generation failed: ${result}\n${hashes}\n${error}")
endif()
set(drivenHash "${CMAKE_MATCH_1}")
set(cacheOnlyHash "${CMAKE_MATCH_2}")
set(plainHash "${CMAKE_MATCH_3}")
set(stoppingHash "${CMAKE_MATCH_4}")
file(SHA256 "${surveyDirectory}/survey.code" surveyCodeBefore)
file(SHA256 "${surveyDirectory}/survey.kpm" surveyManifestBefore)

execute_process(COMMAND "${probe}" --cache "${surveyDirectory}/survey.code" --all --subgroup 32
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
string(REPLACE "\r\n" "\n" stdout "${stdout}")
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "kyty_rt_probe --all failed with ${result}\n${stdout}\n${stderr}")
endif()
function(requireLine pattern)
    if(NOT stdout MATCHES "${pattern}")
        message(FATAL_ERROR "kyty_rt_probe --all: missing ${pattern}\n${stdout}")
    endif()
endfunction()
requireLine("(^|\n)rt-survey 1 build=[^ \n]+ oracle=1 subgroup=32 lds_limit=49152\n")
set(emptyDiagnostics "diagnostics=missing_tlas_source:1,no_form_or_host_query:1")
requireLine("program ${drivenHash} stage=cs wave=32 group=32,1,1 lds=0 scratch=0 modules=1 source=manifest status=ok bvh=1 native=0 oracle=0 lane=0 empty=1 emulated=0 spirv=valid ${emptyDiagnostics}\n")
requireLine("program ${cacheOnlyHash} stage=cs wave=32 group=8,8,1 lds=8192 scratch=16384 modules=0 source=code status=ok bvh=1 native=0 oracle=0 lane=0 empty=1 emulated=0 spirv=valid ${emptyDiagnostics}\n")
requireLine("program ${cacheOnlyHash} stage=cs wave=64 group=8,8,1 lds=8192 scratch=16384 modules=0 source=code status=ok bvh=1 native=0 oracle=0 lane=0 empty=1 emulated=0 spirv=valid ${emptyDiagnostics}\n")
set(stopped "status=stop bvh=0 native=0 oracle=0 lane=0 empty=0 emulated=0 spirv=none[^\n]* phase=translate stop=shader_resource_tracking:[^\n]*buffer_descriptor_is_not_a_valid_runtime_value[^\n]*\n")
requireLine("program ${stoppingHash} stage=cs wave=32 group=8,8,1 lds=8192 scratch=16384 modules=0 source=code ${stopped}")
requireLine("program ${stoppingHash} stage=cs wave=64 group=8,8,1 lds=8192 scratch=16384 modules=0 source=code ${stopped}")
requireLine("summary records=4 manifest_modules=3 manifest_skipped=0 code_only=2 programs=5 intersections=3 missing_code=1 unreadable=0 undecodable=0 truncated=0 seconds=")
if(stdout MATCHES "program ${plainHash}")
    message(FATAL_ERROR "kyty_rt_probe --all listed a program without BVH intersections\n${stdout}")
endif()
if(NOT stderr STREQUAL "")
    message(FATAL_ERROR "kyty_rt_probe --all wrote to stderr\n${stderr}")
endif()
file(SHA256 "${surveyDirectory}/survey.code" surveyCodeAfter)
file(SHA256 "${surveyDirectory}/survey.kpm" surveyManifestAfter)
if(NOT surveyCodeAfter STREQUAL surveyCodeBefore OR NOT surveyManifestAfter STREQUAL surveyManifestBefore)
    message(FATAL_ERROR "kyty_rt_probe --all changed the cache or the manifest")
endif()

file(REMOVE "${surveyDirectory}/survey.kpm")
execute_process(COMMAND "${probe}" --cache "${surveyDirectory}/survey.code" --all --oracle 0 --subgroup 64
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
string(REPLACE "\r\n" "\n" stdout "${stdout}")
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "kyty_rt_probe --all without a manifest failed with ${result}\n${stdout}\n${stderr}")
endif()
requireLine("rt-survey 1 build=[^ \n]+ oracle=0 subgroup=64 lds_limit=49152\nnote no pipeline manifest next to the cache")
requireLine("program ${stoppingHash} stage=cs wave=64 [^\n]*${stopped}")
requireLine("summary records=4 manifest_modules=0 manifest_skipped=0 code_only=4 programs=6 ")

execute_process(COMMAND "${probe}" --cache "${surveyDirectory}/blocked.code" --all
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result STREQUAL "2" OR NOT stderr MATCHES "cannot open")
    message(FATAL_ERROR "kyty_rt_probe --all on a missing cache: expected exit 2, got ${result}\n${stdout}\n${stderr}")
endif()
execute_process(COMMAND "${probe}" --all
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result STREQUAL "64")
    message(FATAL_ERROR "kyty_rt_probe --all without a cache: expected the usage exit 64, got ${result}")
endif()
