math(EXPR writerArgument "${CMAKE_ARGC} - 2")
math(EXPR probeArgument "${CMAKE_ARGC} - 1")
set(probe "${CMAKE_ARGV${probeArgument}}")
file(MAKE_DIRECTORY "${DIRECTORY}/blocked.spv")
set(raw "${DIRECTORY}/shader.bin")
set(later "${DIRECTORY}/later.bin")
set(cache "${DIRECTORY}/manifest.spv.guest.spv")
set(plain "${DIRECTORY}/single.spv")
set(pair "${DIRECTORY}/pair.spv")
set(shared "${DIRECTORY}/shared.spv")
set(link "${DIRECTORY}/later-link.spv")
set(early "${DIRECTORY}/early.spv")
set(full "${DIRECTORY}/full.spv")
file(REMOVE "${plain}" "${pair}" "${pair}.guest.spv" "${shared}" "${shared}.guest.spv" "${link}" "${early}" "${full}" "${DIRECTORY}/manifest.spv")
execute_process(COMMAND "${CMAKE_ARGV${writerArgument}}" write-export-fixture "${DIRECTORY}"
        RESULT_VARIABLE result OUTPUT_VARIABLE hash ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result STREQUAL "0" OR NOT hash MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "probe fixture generation failed: ${result}\n${hash}\n${error}")
endif()
configure_file("${raw}" "${later}" COPYONLY)
file(SHA256 "${raw}" rawHash)
file(SHA256 "${cache}" cacheHash)

function(runProbe expectedOutput expectedError)
    execute_process(COMMAND "${probe}" ${ARGN}
            RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result STREQUAL "2" OR NOT stdout MATCHES "${expectedOutput}" OR NOT stderr MATCHES "${expectedError}" OR
            (expectedError STREQUAL "" AND stderr MATCHES "SPIR-V outputs? alias|cannot (open|write|close) SPIR-V output"))
        message(FATAL_ERROR "kyty_rt_probe ${ARGN}: expected exit 2 and matching evidence, got ${result}\n${stdout}\n${stderr}")
    endif()
endfunction()

function(requireSpirv path)
    file(READ "${path}" magic LIMIT 4 HEX)
    file(SIZE "${path}" size)
    if(NOT magic STREQUAL "03022307" OR size LESS_EQUAL 20)
        message(FATAL_ERROR "missing emitted SPIR-V: ${path}")
    endif()
endfunction()

runProbe("spirv=[1-9][0-9]* words" "" --spirv "${plain}" "${raw}")
requireSpirv("${plain}")
runProbe("replay=no" "" --replay-check --spirv "${pair}" --cache "${cache}" --hash "${hash}")
requireSpirv("${pair}")
requireSpirv("${pair}.guest.spv")

runProbe("" "SPIR-V output aliases" --spirv "${raw}" "${raw}")
file(CREATE_LINK "${later}" "${link}")
runProbe("" "SPIR-V output aliases" --spirv "${early}" "${raw}" --spirv "${link}" "${later}")
runProbe("" "SPIR-V output aliases" --replay-check --spirv "${cache}" --cache "${cache}" --hash "${hash}")
runProbe("" "SPIR-V output aliases" --replay-check --spirv "${DIRECTORY}/manifest.spv" --cache "${cache}" --hash "${hash}")
configure_file("${raw}" "${shared}" COPYONLY)
file(CREATE_LINK "${shared}" "${shared}.guest.spv")
runProbe("" "SPIR-V outputs? alias" --replay-check --spirv "${shared}" "${raw}")
if(EXISTS "${early}" OR EXISTS "${DIRECTORY}/manifest.spv")
    message(FATAL_ERROR "preflight failure wrote an earlier output")
endif()
file(SHA256 "${raw}" rawAfter)
file(SHA256 "${later}" laterAfter)
file(SHA256 "${cache}" cacheAfter)
file(SHA256 "${shared}" sharedAfter)
if(NOT rawAfter STREQUAL rawHash OR NOT laterAfter STREQUAL rawHash OR
        NOT cacheAfter STREQUAL cacheHash OR NOT sharedAfter STREQUAL rawHash)
    message(FATAL_ERROR "an alias rejection changed an input or output")
endif()

runProbe("" "cannot open SPIR-V output" --spirv "${DIRECTORY}/blocked.spv" "${raw}")
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    file(CREATE_LINK /dev/full "${full}" SYMBOLIC)
    runProbe("" "cannot (close|write) SPIR-V output" --spirv "${full}" "${raw}")
    file(REMOVE "${full}")
endif()
